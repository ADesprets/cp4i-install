{
    "api_version": "2.0.0",
    "name": "keycloak-oidc",
    "title": "Keycloak OIDC",
    "summary": "Keycloak OIDC user registry (${MY_KEYCLOAK_CP4I_REALM} realm)",
    "registry_type": "oidc",
    "visibility": {
        "type": "public"
    },
    "case_sensitive": false,
    "email_required": false,
    "email_unique_if_exist": true,
    "configuration": {
		"provider_type": "standard",
        "scope": "openid",
        "client_id": "${MY_KEYCLOAK_APIC_CLIENT_ID}",
        "client_secret": "${APIC_KEYCLOAK_CLIENT_SECRET}",
        "authorization_endpoint": "https://${APIC_KEYCLOAK_HOST}/realms/${MY_KEYCLOAK_CP4I_REALM}/protocol/openid-connect/auth",
        "token_endpoint": {
            "endpoint": "https://${APIC_KEYCLOAK_HOST}/realms/${MY_KEYCLOAK_CP4I_REALM}/protocol/openid-connect/token",
            "tls_client_profile_url": "${APIC_TLS_CLIENT_PROFILE_DEFAULT_URL}"
        },
        "jwks_uri": {
            "endpoint": "https://${APIC_KEYCLOAK_HOST}/realms/${MY_KEYCLOAK_CP4I_REALM}/protocol/openid-connect/certs",
            "tls_client_profile_url": "${APIC_TLS_CLIENT_PROFILE_DEFAULT_URL}"
        },
		"oidc_rp_logout": {
			"enabled": false,
			"include_refresh_token": false,
			"endpoint": {}
		},		"response_type": "code",
		"credential_location": "auth_header",
		"features": [],
		"field_mapping": {
			"email": "email",
			"username": "name",
			"first_name": "given_name",
			"last_name": "family_name"
		},
		"userinfo_endpoint": {
			"endpoint": "https://${APIC_KEYCLOAK_HOST}/realms/${MY_KEYCLOAK_CP4I_REALM}/protocol/openid-connect/userinfo",
			"tls_client_profile_url": "${APIC_TLS_CLIENT_PROFILE_DEFAULT_URL}"
		},
		"redirect_uris": {
			"provider": {
				"redirect_uri": "https://${EP_APIC_MGR}/manager/uia/oauth2/redirect",
				"redirect_uri_implicit": "https://${EP_APIC_MGR}/manager/oauth2/redirect",
				"oidc_redirect_uri": "https://${EP_API}/api/oauth2/redirect"
			},
			"admin": {
				"redirect_uri": "https://${EP_CM}/admin/uia/oauth2/redirect",
				"redirect_uri_implicit": "https://${EP_CM}/admin/oauth2/redirect",
				"oidc_redirect_uri": "https://${EP_API}/api/oauth2/redirect"
			},
			"consumer": {
				"redirect_uri": "https://${EP_PDEV_WEB}/consumer-api/ibm_apim/oauth2/redirect",
				"oidc_redirect_uri": "https://${EP_PDEV_WEB}/consumer-api/oauth2/redirect"
			}
		}
    },
    "integration_url": "${APIC_OIDC_INTEGRATION_URL}"
}
